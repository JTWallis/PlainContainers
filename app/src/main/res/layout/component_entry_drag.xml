<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/backgroundFill">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineDragOuterVert1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.1"
    />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clInner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_outline_rounded_dark"
        android:padding="@dimen/bgBorderThickness"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineDragVert1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.1"
        />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineDragVert2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.9"
            />

        <FrameLayout
            android:id="@+id/wrapperDrag"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/backgroundFill"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guidelineDragVert1"
            app:layout_constraintTop_toTopOf="@id/containerEntryBase"
            app:layout_constraintBottom_toBottomOf="@id/containerEntryBase"
        >
            <include layout="@layout/component_drag"
                android:id="@+id/containerDrag"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
            />
        </FrameLayout>



        <include layout="@layout/component_entry"
            android:id="@+id/containerEntryBase"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/guidelineDragVert1"
            app:layout_constraintEnd_toStartOf="@id/guidelineDragVert2"
            />

        <include layout="@layout/component_expand"
            android:id="@+id/containerExpand"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="@id/guidelineDragVert2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/containerEntryBase"
            app:layout_constraintBottom_toBottomOf="@id/containerEntryBase"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>



    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvItems"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/backgroundFill"
        app:layout_constraintStart_toStartOf="@id/guidelineDragOuterVert1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/clInner"
        app:layout_constraintBottom_toBottomOf="parent"
    />

</androidx.constraintlayout.widget.ConstraintLayout>