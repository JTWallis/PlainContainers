<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewCapture"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
    />

    <View
        android:id="@+id/viewCaptureCrop"
        android:layout_width="@dimen/captureCropSquareSize"
        android:layout_height="@dimen/captureCropSquareSize"
        android:background="@drawable/bg_outline_semitransparent"
        android:layout_gravity="center"
        android:layout_marginBottom="@dimen/captureMarginBottom"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
    />

    <Button
        android:id="@+id/btnCapture"
        android:layout_width="@dimen/captureButtonSize"
        android:layout_height="@dimen/captureButtonSize"
        android:background="@drawable/button_round"
        android:layout_gravity="bottom|center"
        android:layout_marginBottom="@dimen/captureMarginBottom"
        app:layout_constraintTop_toBottomOf="@id/viewCaptureCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
    />
</androidx.constraintlayout.widget.ConstraintLayout>