<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/viewPadding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:showDividers="middle"
        android:divider="@drawable/empty_divider">

        <Button
            android:id="@+id/btnAboutLicenses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/button_background_default"
            android:drawableLeft="@drawable/document_24"
            android:drawablePadding="@dimen/paddingDrawable"
            android:text="@string/about_licenses"
            android:textAppearance="@style/Widget.PlainContainers.Text.Button"
            android:gravity="start|center"
            android:padding="0dp"
        />

        <Button
            android:id="@+id/btnAboutVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/button_background_default"
            android:drawableLeft="@drawable/info_24"
            android:drawablePadding="@dimen/paddingDrawable"
            android:text="@string/about_version"
            android:textAppearance="@style/Widget.PlainContainers.Text.Button"
            android:gravity="start|center"
            android:padding="0dp"
        />

    </LinearLayout>

</ScrollView>