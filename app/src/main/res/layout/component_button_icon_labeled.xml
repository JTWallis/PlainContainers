<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cvBtnLabeled"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/cornerRadiusSmall"
    app:cardBackgroundColor="@color/border"
>
    <Button
        android:id="@+id/btnLabeled"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="@dimen/borderThicknessSmall"
        android:padding="@dimen/paddingButton"
        android:background="@color/backgroundDefault"
        android:drawablePadding="@dimen/paddingDrawable"
        android:text="Labeled Button"
        android:textAppearance="@style/Widget.PlainContainers.Text.Button.Labeled"
        android:textAlignment="textStart"
    />
</androidx.cardview.widget.CardView>