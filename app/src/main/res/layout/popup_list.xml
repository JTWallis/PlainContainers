<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/cornerRadiusDefault"
    app:cardBackgroundColor="@color/border"
    app:cardElevation="0dp"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/backgroundDefault"
        android:layout_margin="@dimen/borderThicknessMedium"
        android:padding="@dimen/viewPadding"
        android:minWidth="@dimen/popupListMinWidth"
        android:minHeight="@dimen/popupListMinHeight"
        >

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelinePopupListVert1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.1"
        />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelinePopupListVert2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.9"
            />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelinePopupListHorz1"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.1"
            />

        <ImageButton
            android:id="@+id/btnPopupListBack"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/arrow_small_left_24"
            android:contentDescription="@string/accessibility_btn_dismiss_popup"
            android:scaleType="centerCrop"
            android:background="@color/backgroundDefault"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/guidelinePopupListHorz1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guidelinePopupListVert1"
        />

        <TextView
            android:id="@+id/txtPopupListTitle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:gravity="center_vertical"
            android:layout_marginStart="@dimen/popupListTitleMargin"
            android:text="@string/popup_sort_title"
            android:textAppearance="@style/Widget.PlainContainers.Text.Title"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/guidelinePopupListHorz1"
            app:layout_constraintStart_toStartOf="@id/guidelinePopupListVert1"
            app:layout_constraintEnd_toEndOf="@id/guidelinePopupListVert2"
            />

        <ListView
            android:id="@+id/lvPopupList"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/popupListItemListMargin"
            android:divider="@color/backgroundDefault"
            android:dividerHeight="@dimen/emptyDividerHeight"
            app:layout_constraintTop_toBottomOf="@id/guidelinePopupListHorz1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>

