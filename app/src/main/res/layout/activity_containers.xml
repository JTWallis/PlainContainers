<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <include layout="@layout/toolbar_appbar"
        android:id="@+id/layoutToolbar"
    />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/viewPadding"
        android:showDividers="middle"
        android:divider="@drawable/empty_divider">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include layout="@layout/component_sort"
            android:id="@+id/layoutSort"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
        />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Drag Sorting"
            android:textSize="@dimen/fontSizeDefault"
            android:layout_toStartOf="@id/switchDrag"
            android:layout_centerVertical="true"
        />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchDrag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
        />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/horizontalBarHeight"
        android:background="@color/lightgray"
    />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include layout="@layout/component_add"
            android:id="@+id/layoutAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
        />
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvContainers"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp"
        android:clipToPadding="false"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_outline_rounded"
        android:nestedScrollingEnabled="false"
    />

    </LinearLayout>
</LinearLayout>